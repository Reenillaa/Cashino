# Copy to .env (never commit real values). The app works fully offline when these are empty.
# Supabase project → Settings → API. Use the PUBLISHABLE (anon) key only — never the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Social sign-in buttons to show, only once enabled in Supabase → Authentication → Providers (e.g. google,apple)
EXPO_PUBLIC_OAUTH_PROVIDERS=
# Show the magic-link button (needs custom SMTP configured in Supabase): 1 to enable
EXPO_PUBLIC_MAGIC_LINK=

# Optional: override the provisional bundle identifier and link the EAS project
APP_BUNDLE_ID=app.titanium.provisional
EAS_PROJECT_ID=

# Edge Functions secrets are set with `supabase secrets set` (SUPABASE_SERVICE_ROLE_KEY is injected by
# the platform automatically) — they must NOT live in this file.
